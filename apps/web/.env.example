# ==============================================================================
# Public Website Environment Variables (apps/web)
# DO NOT put the Supabase Service Role Key or Admin secrets in this file!
# Copy this file to .env.local and fill in the values.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous Public Key (safe to use in browser / public site)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash Redis (For server-side distributed rate limiting)
# Get these from console.upstash.com -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile CAPTCHA (Optional in local dev, recommended in production)
# Get Site Key from Cloudflare Dashboard -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
